{
  "name": "jookoi-frontpage",
  "version": "0.0.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/primeui-license.mjs && ng serve",
    "build": "node scripts/primeui-license.mjs && node scripts/build-library-content.mjs && ng build --stats-json",
    "watch": "node scripts/primeui-license.mjs && ng build --watch --configuration development",
    "content": "node scripts/build-library-content.mjs",
    "content:sync": "node scripts/sync-learn-content.mjs",
    "test": "node scripts/primeui-license.mjs && ng test",
    "test:ci": "node scripts/primeui-license.mjs && ng test --watch=false --browsers=chromiumHeadless",
    "ux:smoke": "node scripts/ux-smoke.mjs",
    "ux:lab": "node scripts/ux-lab.mjs",
    "serve:static-build": "node scripts/serve-static-build.mjs",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ux:lab:record": "node scripts/ux-lab.mjs --record",
    "ux:lab:ci": "node scripts/ux-lab.mjs --strict",
    "build:gh-pages": "node scripts/build-gh-pages.mjs"
  },
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@angular/aria": "~22.1.6",
    "@angular/cdk": "~22.1.6",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "@ngrx/signals": "~22.0.1",
    "@primeuix/themes": "^3.0.0",
    "mermaid": "^11.17.2",
    "primeng": "~22.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.19",
    "@vitest/browser-playwright": "~4.1.11",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "lighthouse": "^13.5.0",
    "marked": "^18.0.13",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "~4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
